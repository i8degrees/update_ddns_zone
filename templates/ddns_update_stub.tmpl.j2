#!/bin/sh
#
# ddns_update launch wrapper script
#
# This script was generated by Ansible on {{ template_host }}
# Current run date: {{ template_run_date }}

# SEE ALSO
# 1. man 8 dnsmasq
# 2. https://thekelleys.org.uk/dnsmasq/docs/dnsmasq-man.html
# 3. /usr/lib/dnsmasq/dhcp-script.sh on OpenWRT (dnsmasq-full)
#

# process control for app; these used to be pulled from dotenv
DEBUG={{ debug }}
DEBUG_TRACE={{ debug_trace }}
VERBOSE={{ verbose }}
SYSLOG={{ syslog }}

# DDNS Update configuration file
DDNS_UPDATE_CONFIG={{ ddns_update_config }}; export DDNS_UPDATE_CONFIG

# X-API-Key field required by PowerDNS Auth Webserver
PDNS_API_KEY={{ pdns_api_key }}; export PDNS_API_KEY

/root/.local/share/pipx/venvs/{{ project_name }}/bin/{{ script_exe }} \
  --config "${DDNS_UPDATE_CONFIG}" "$@"

unset DDNS_UPDATE_CONFIG
unset PDNS_API_KEY

