# auto-generated config file from /etc/config/dhcp
conf-file=/etc/dnsmasq.conf
strict-order
no-resolv
read-ethers
enable-ubus=dnsmasq.dhcp_IOT
bind-dynamic
log-dhcp
dhcp-sequential-ip
dhcp-rapid-commit
log-facility=AUTH
cache-size=0
dns-forward-max=0
port=0
dhcp-lease-max=64
domain=iot.home.arpa
interface=br-lan.14
except-interface=lo
except-interface=wan
except-interface=wan6
addn-hosts=/tmp/hosts
dhcp-leasefile=/tmp/dhcp.leases.IOT
dhcp-script=/usr/lib/dnsmasq/dhcp-script.sh
script-arp
dhcp-broadcast=tag:needs-broadcast
conf-dir=/tmp/dnsmasq.dhcp_IOT.d
user=dnsmasq
group=dnsmasq

dhcp-ignore-names=tag:dhcp_bogus_hostname
conf-file=/usr/share/dnsmasq/dhcpbogushostname.conf

no-dhcp-interface=wan
dhcp-range=set:IOT,192.168.14.100,192.168.14.163,255.255.255.0,1h
dhcp-option=IOT,3,192.168.14.252
dhcp-option=IOT,42,192.168.14.138,192.168.12.138
dhcp-option=IOT,6,192.168.14.252,192.168.12.12
dhcp-option=IOT,15,iot.home.arpa
dhcp-option=IOT,119,iot.home.arpa,ha.home.arpa,home.arpa
no-dhcp-interface=wg0
